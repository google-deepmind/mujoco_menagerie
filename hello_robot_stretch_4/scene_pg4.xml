<mujoco model="stretch4 pg4 scene">
  <include file="stretch4_pg4.xml"/>

  <statistic center="0 0 0.6" extent="1.4" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="1 -1 2.5" dir="-0.4 0.4 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <contact>
    <!-- The omniwheels roll along their contact normal and slide along their axis. MuJoCo cannot
         express that with a single geom, so the floor pairs carry the anisotropic friction. -->
    <pair geom1="floor" geom2="left_wheel_link" condim="3" friction="0.001 1" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="right_wheel_link" condim="3" friction="0.001 1" solref="0.005 1"
      solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="back_wheel_link" condim="3" friction="0.001 1" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <pair geom1="floor" geom2="base_link_collision" condim="3" friction="0 0"/>
  </contact>
</mujoco>
