<mujoco model="stretch4">
  <compiler angle="radian" assetdir="assets" autolimits="true"/>

  <option integrator="implicitfast" impratio="20" cone="elliptic" noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>

  <default>
    <default class="stretch">
      <geom mass="0" solref="0.005 1"/>
      <general biastype="affine"/>
      <default class="wheel">
        <velocity kv="1" gear="6" forcerange="-100 100"/>
      </default>
      <default class="lift">
        <joint damping="20" stiffness="0.03" armature="0.01" frictionloss="1.5"/>
        <general forcerange="-200 200"/>
        <position kp="8000" kv="200"/>
      </default>
      <default class="telescope">
        <joint damping="20" stiffness="0.02" armature="0.01" frictionloss="1.5"/>
        <general forcerange="-175 175"/>
        <position kp="2500" kv="120"/>
      </default>
      <default class="wrist">
        <general forcerange="-400 400"/>
        <joint axis="0 0 1" damping="1"/>
        <position kp="10"/>
        <default class="wrist_yaw">
          <joint armature="0.01" damping="2" frictionloss="0.1"/>
          <position kp="400" kv="4.3"/>
        </default>
        <default class="wrist_pitch">
          <joint armature="0.01" damping="2" frictionloss="0.1"/>
          <position kp="400" kv="3.5"/>
        </default>
        <default class="wrist_roll">
          <joint armature="0.01" damping="2" frictionloss="0.1"/>
          <position kp="250" kv="1.2"/>
        </default>
        <default class="finger_open">
          <default class="gripper_right_finger">
            <joint axis="0 1 0" range="0 0.5" damping="10" armature="0.1" frictionloss="0.1"/>
            <position ctrlrange="0 0.5" kp="500" kv="20" forcerange="-30 30"/>
          </default>
          <default class="gripper_left_finger">
            <joint axis="0 -1 0" range="0 0.5" damping="10" armature="0.1" frictionloss="0.1"/>
            <position ctrlrange="0 0.5" kp="500" kv="20" forcerange="-30 30"/>
          </default>
        </default>
        <default class="fingertip_compliance">
          <joint type="hinge" range="-0.15 0.15" limited="true" springref="0" stiffness="1" damping="0.01"
            armature="2e-05" solreflimit="0.005 1" solimplimit="0.95 0.999 0.001"/>
        </default>
      </default>
      <default class="visualgeom">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="mesh"/>
        <default class="rubber">
          <geom condim="6" friction="1.8 0.01 0.001" priority="1" solref="0.01 1" solimp="0.95 0.999 0.005"
            conaffinity="1" contype="1"/>
        </default>
        <default class="omniwheel_collision">
          <geom type="capsule" size="0.1 0.01" condim="6" friction="0.05 0.8 0.001" contype="6" conaffinity="4"
            group="4"/>
        </default>
      </default>
    </default>
  </default>

