<mujoco model="ur10">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ur10">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="shoulder">
        <general gainprm="24000" biasprm="0 -24000 -1600" forcerange="-330 330"/>
      </default>
      <default class="elbow">
        <joint range="-3.14159 3.14159"/>
        <general ctrlrange="-3.14159 3.14159" gainprm="8300" biasprm="0 -8300 -620" forcerange="-150 150"/>
      </default>
      <default class="wrist">
        <general gainprm="1200" biasprm="0 -1200 -26" forcerange="-56 56"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material class="ur10" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur10" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur10" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur10" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 2"/>
    <body name="base" quat="0 0 0 -1" childclass="ur10">
      <inertial mass="4" pos="0 0 0" diaginertia="0.00610633 0.00610633 0.01125"/>
      <geom mesh="base" material="linkgray" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.1273">
        <inertial mass="7.1" pos="-0.021 0.027 0" quat="0.431167 0.408889 0.556786 0.580426"
          diaginertia="0.0202532 0.0352903 0.0353866"/>
        <joint name="shoulder_pan_joint" class="shoulder" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="jointgray" class="visual"/>
        <geom mesh="shoulder_1" material="urblue" class="visual"/>
        <geom mesh="shoulder_2" material="black" class="visual"/>
        <geom class="collision" pos="0 0 0.0184" size="0.0759 0.0315"/>
        <body name="upper_arm_link" pos="0 0.176 0" quat="1 0 1 0">
          <inertial mass="12.7" pos="0 -0.018 0.232" quat="0.707083 0.000176231 -0.706978 -0.0147046"
            diaginertia="0.0278114 0.769758 0.77068"/>
          <joint name="shoulder_lift_joint" class="shoulder"/>
          <geom mesh="upperarm_0" material="jointgray" class="visual"/>
          <geom mesh="upperarm_1" material="linkgray" class="visual"/>
          <geom mesh="upperarm_2" material="urblue" class="visual"/>
          <geom mesh="upperarm_3" material="black" class="visual"/>
          <geom class="collision" pos="0 -0.0821 0" quat="1 1 0 0" size="0.0762 0.131"/>
          <geom class="collision" pos="0 0 0.306" size="0.0541 0.265"/>
          <body name="forearm_link" pos="0 -0.126958 0.612">
            <inertial mass="4.27" pos="0 0.018958 0.3323" quat="0.707122 -0.0105722 0.706923 -0.0112575"
              diaginertia="0.00985709 0.306743 0.30928"/>
            <joint name="elbow_joint" class="elbow"/>
            <geom mesh="forearm_0" material="black" class="visual"/>
            <geom mesh="forearm_1" material="jointgray" class="visual"/>
            <geom mesh="forearm_2" material="linkgray" class="visual"/>
            <geom mesh="forearm_3" material="urblue" class="visual"/>
            <geom class="collision" pos="0 0.0634 0" quat="1 1 0 0" size="0.0615 0.1"/>
            <geom class="collision" pos="0 0 0.288" size="0.0438 0.255"/>
            <body name="wrist_1_link" pos="0 0 0.5723" quat="1 0 1 0">
              <inertial mass="2" pos="0 0.121899 0.018" quat="0.364678 0.601507 -0.378881 -0.601372"
                diaginertia="0.00209991 0.00269992 0.00296017"/>
              <joint name="wrist_1_joint" class="wrist"/>
              <geom mesh="wrist1_0" material="jointgray" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="black" class="visual"/>
              <geom class="collision" pos="0 0.0515 0" quat="1 1 0 0" size="0.0467 0.0855"/>
              <body name="wrist_2_link" pos="0 0.114899 0">
                <inertial mass="2" pos="0 0.018 0.1087" quat="0.683196 0.167463 -0.693144 -0.157325"
                  diaginertia="0.00209991 0.00269992 0.00296017"/>
                <joint name="wrist_2_joint" class="wrist" axis="0 0 1"/>
                <geom mesh="wrist2_0" material="jointgray" class="visual"/>
                <geom mesh="wrist2_1" material="urblue" class="visual"/>
                <geom mesh="wrist2_2" material="black" class="visual"/>
                <geom class="collision" pos="0 0 0.0526" size="0.0457 0.0861"/>
                <geom class="collision" pos="0 0.00231 0.116" quat="1 1 0 0" size="0.0456 0.0365"/>
                <body name="wrist_3_link" pos="0 0 0.1157">
                  <inertial mass="0.365" pos="0 0.0662 0" diaginertia="0.0004 0.00034 0.00041"/>
                  <joint name="wrist_3_joint" class="wrist"/>
                  <geom mesh="wrist3" material="linkgray" class="visual"/>
                  <geom class="eef_collision" pos="0 0.0769 0" quat="1 1 0 0" size="0.0453 0.0153"/>
                  <site name="attachment_site" pos="0 0.0922 0" quat="-1 1 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general class="shoulder" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="shoulder" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="elbow" name="elbow" joint="elbow_joint"/>
    <general class="wrist" name="wrist_1" joint="wrist_1_joint"/>
    <general class="wrist" name="wrist_2" joint="wrist_2_joint"/>
    <general class="wrist" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0" ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0"/>
  </keyframe>
</mujoco>
