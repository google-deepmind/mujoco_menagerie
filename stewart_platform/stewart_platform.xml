<mujoco model="stewart_platform">
  <compiler angle="radian" meshdir="assets" autolimits="true" inertiafromgeom="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="stewart">
      <geom type="mesh" contype="0" conaffinity="0"/>

      <default class="hinge">
        <joint type="hinge"/>
      </default>
      <default class="slide">
        <joint type="slide" axis="0 0 1" springdamper="0.1 7" range="-0.1 0.35"/>
      </default>

      <default class="leg_actuator">
        <general gear="1 0 0 0 0 0" ctrlrange="-400 400" forcerange="-400 400"/>
      </default>
      <default class="disturbance">
        <general ctrlrange="-500 500" forcerange="-500 500"/>
      </default>

      <default class="base">
        <geom mesh="base" material="base_mat" mass="20"/>
      </default>
      <default class="upper">
        <geom mesh="upper" material="upper_mat" mass="20"/>
      </default>
      <default class="cardan1">
        <geom mesh="cardan1" material="cardan_mat" mass="0.05"/>
      </default>
      <default class="cardan2">
        <geom mesh="cardan2" material="cardan_mat" mass="0.02"/>
      </default>
      <default class="legbot">
        <geom mesh="legbot" material="leg_lower_mat" mass="10"/>
      </default>
      <default class="legup">
        <geom mesh="legup" material="leg_upper_mat" mass="5"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="base_mat" rgba="0.5 0.5 0.5 1"/>
    <material name="upper_mat" rgba="0.2 0.45 0.85 1"/>
    <material name="cardan_mat" rgba="0.9 0.55 0.1 1"/>
    <material name="leg_lower_mat" rgba="0.75 0.75 0.78 1"/>
    <material name="leg_upper_mat" rgba="0.55 0.55 0.58 1"/>

    <mesh name="base" file="base.stl"/>
    <mesh name="cardan1" file="cardan1.stl"/>
    <mesh name="cardan2" file="cardan2.stl"/>
    <mesh name="legbot" file="legbot.stl"/>
    <mesh name="legup" file="legup.stl"/>
    <mesh name="upper" file="upper.stl"/>
  </asset>

